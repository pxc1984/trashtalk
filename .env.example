# PostgreSQL connection string
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_HOST=db
POSTGRES_DB=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@$POSTGRES_HOST:$POSTGRES_PORT/$POSTGRES_DB?sslmode=disable
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/trashtalk

# Path to Telegram exports root
EXPORTS_DIR=/app/exports

# Telegram bot token (for inline bot)
BOT_TOKEN=

# N-gram configuration
# Highest n-gram order used for generation and trained at ingestion time.
NGRAM_SIZE=3
# Lowest n-gram order kept for backoff: when the exact high-order continuation
# is unknown, generation falls back to this order instead of stopping.
MIN_NGRAM_SIZE=2

# Generation settings
MAX_GENERATION_LENGTH=64
# Sampling temperature: 1.0 = proportional to counts, <1 sharpens, >1 flattens.
GENERATION_TEMPERATURE=0.9
# Keep only the top-K most likely continuations (0 = disabled).
GENERATION_TOP_K=0
# Nucleus sampling: keep the smallest set whose cumulative mass reaches this (1.0 = disabled).
GENERATION_TOP_P=0.9
# Down-weight tokens already generated to break repetition loops (>=1.0).
REPETITION_PENALTY=1.3
# Sample this many candidate continuations and keep the best-scoring one (best-of-N).
NUM_CANDIDATES=3
# Minimum generated tokens before the bot may stop at a sentence boundary.
MIN_GENERATION_TOKENS=4

# Ingestion worker settings
INGESTION_INTERVAL_SECS=30
INGESTION_WORKERS=2